{
  "name": "@yt-equity/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:integration": "node --import tsx --experimental-test-module-mocks --test test/*.test.mjs",
    "test": "node --import tsx --experimental-test-module-mocks --test test/public-visibility.test.mjs",
    "test:reports": "node --import tsx --test test/report*.test.ts",
    "test:relationships": "tsx --test test/relationships.test.ts test/snapshot-cache.test.ts",
    "start": "node ../../scripts/validate-env.mjs api && tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@react-email/components": "^0.0.31",
    "@yt-equity/contracts": "workspace:*",
    "@yt-equity/db": "workspace:*",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
