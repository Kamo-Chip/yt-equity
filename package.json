{
  "name": "yt-equity",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @yt-equity/api --filter @yt-equity/web --filter @yt-equity/extension dev",
    "check": "pnpm -r typecheck && pnpm boundary:check",
    "boundary:check": "node scripts/check-web-boundary.mjs",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @yt-equity/db db:generate",
    "db:migrate": "pnpm --filter @yt-equity/db db:migrate",
    "db:seed": "pnpm --filter @yt-equity/db db:seed",
    "db:seed:creator": "pnpm --filter @yt-equity/db db:seed:creator"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "railway": "3.12.0"
  }
}
